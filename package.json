{
  "name": "eslint-plugin-export-scope",
  "version": "3.1.0",
  "description": "Don't leak LOCAL utils, states, components into the global scope",
  "type": "commonjs",
  "license": "MIT",
  "keywords": [
    "scope",
    "@scope",
    "export",
    "import",
    "public",
    "private",
    "protected",
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "author": "Alex Shleifman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-Shleifman/eslint-plugin-export-scope.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest",
    "test:ts-versions": "s=0; for v in 4.9 5.9 6.0; do npm i --no-save --no-audit --no-fund typescript@~$v.0 && vitest run || { s=1; break; }; done; npm ci --no-audit --no-fund; exit $s",
    "lint": "eslint .",
    "clean": "rm -Rf ./dist/",
    "dev": "tsc --watch",
    "build": "npm run clean && tsc",
    "open-debug-project": "TSS_DEBUG=5667 code test-project"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/scope-manager": "^8.72.1",
    "@typescript-eslint/typescript-estree": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint8": "npm:eslint@^8.57.1",
    "eslint9": "npm:eslint@^9.39.5",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": ">=4.9 <6.1"
  }
}
